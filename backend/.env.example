DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public" # database url connection

DB_NAME=db-name # database name
DB_USER=db-user # database user
DB_PASSWORD=db-password # database password

JWT_SECRET="your_jwt_secret" # JWT secret key

CLIENT_URL="http://localhost:3000" # client URL for CORS

USER_NAME="your_username" # default user name
USER_EMAIL="your_email" # default user email
USER_PASSWORD="your_password" # default user password
